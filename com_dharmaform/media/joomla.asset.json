{
	"$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
	"name": "com_dharmaform",
	"version": "0.1.0",
	"description": "Dharma Form: стиль и скрипт форм",
	"license": "GPL-2.0-or-later",
	"assets": [
		{
			"name": "com_dharmaform.form",
			"type": "style",
			"uri": "com_dharmaform/form.css",
			"version": "auto"
		},
		{
			"name": "com_dharmaform.form",
			"type": "script",
			"uri": "com_dharmaform/form.js",
			"version": "auto",
			"attributes": {
				"defer": true
			}
		},
		{
			"name": "com_dharmaform.notify-test",
			"type": "script",
			"uri": "com_dharmaform/notify-test.js",
			"version": "auto",
			"attributes": {
				"defer": true
			}
		},
		{
			"name": "com_dharmaform.copy",
			"type": "script",
			"uri": "com_dharmaform/copy.js",
			"version": "auto",
			"attributes": {
				"defer": true
			}
		},
		{
			"name": "com_dharmaform.form-ui",
			"type": "script",
			"uri": "com_dharmaform/form-ui.js",
			"version": "auto",
			"attributes": {
				"defer": true
			}
		}
	]
}
